\name{escapeR_file}
\alias{escapeR_file}
\alias{survey_counts}
\title{Helper Data Functions}
\usage{
escapeR_file(filename)

survey_counts()
}
\arguments{
\item{filename}{Name of a bundled file in \code{inst/extdata}.}
}
\value{\code{escapeR_file()} returns a file path, and \code{survey_counts()} returns a data frame.}
\description{Small helper functions used by the escape-room puzzles.}
