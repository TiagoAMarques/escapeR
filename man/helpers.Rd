\name{escapeR_file}
\alias{escapeR_file}
\alias{survey_counts}
\alias{plot_detection}
\title{Helper Data and Plotting Functions}
\usage{
escapeR_file(filename)

survey_counts()

plot_detection()
}
\arguments{
\item{filename}{Name of a bundled file in \code{inst/extdata}.}
}
\value{\code{escapeR_file()} returns a file path, \code{survey_counts()} returns a data frame, and \code{plot_detection()} invisibly returns the plotted data.}
\description{Small helper functions used by the escape-room puzzles.}
